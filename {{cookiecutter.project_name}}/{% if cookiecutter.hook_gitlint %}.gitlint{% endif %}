[general]
# A body is optional
ignore=body-min-length,body-is-missing
{%- if cookiecutter.require_pr_number_on_merge %}
# merge-requires-pr-number checks merges; the other rules skip them (see ignore-by-title:merges)
ignore-merge-commits=false
{%- endif %}
extra-path=.commit_hooks
regex-style-search=true

[title-max-length]
line-length=72
{%- if cookiecutter.require_jira_prefix %}

[title-match-regex]
regex=^[A-Z][A-Z0-9_]+-\d+:
{%- endif %}

[body-max-line-length]
line-length=72

[ignore-body-lines]
# A URL or a Co-authored-by trailer stops working if it is wrapped
regex=(?i)^(\s*https?://\S+\s*|co-authored-by: .*)$
{%- if cookiecutter.require_pr_number_on_merge %}

[merge-requires-pr-number]
long-lived-branches=master,main,dev,develop

[ignore-by-title:merges]
# git writes merge messages; a hook such as merge-issue-number-hook may add a Jira key in front
regex=^([A-Z][A-Z0-9_]+-\d+: )?Merge
# Replaces the [general] ignore list for these commits, so those rules are listed again
ignore=title-max-length,title-imperative-mood,title-capitalized,title-match-regex,title-trailing-punctuation,body-max-line-length,body-min-length,body-is-missing
{%- endif %}

[ignore-by-title]
# gitlint skips fixup!, squash!, amend! and revert commits on its own, but not once a Jira key is
# in front (e.g. added by merge-issue-number-hook)
{%- if cookiecutter.require_pr_number_on_merge %}
regex=^[A-Z][A-Z0-9_]+-\d+: ((fixup|squash|amend)! |Revert ")
{%- else %}
regex=^[A-Z][A-Z0-9_]+-\d+: ((fixup|squash|amend)! |Revert "|Merge )
{%- endif %}
ignore=all
