"""
Custom gitlint rule, loaded through extra-path in .gitlint
"""

import re
import subprocess
from collections.abc import Collection, Sequence

from gitlint.git import GitCommit
from gitlint.options import ListOption
from gitlint.rules import CommitRule, RuleViolation

PR_NUMBER = re.compile(r"#\d+\b")


def git_succeeds(*args: str) -> bool:
    """
    Run a git command and report whether it succeeded

    :param args: Arguments for git
    :return: True if git exited with status 0
    """
    return subprocess.run(["git", *args], capture_output=True).returncode == 0


def merge_needs_pr_number(long_lived_branches: Collection[str]) -> bool:
    """
    Check whether the commit being made merges new commits into a long-lived branch

    shortcut: relies on MERGE_HEAD, so only commits being made are checked, not existing history.

    :param long_lived_branches: Branches that PRs are merged into
    :return: True for a merge into a long-lived branch of commits none of them has yet
    """
    if not git_succeeds("rev-parse", "-q", "--verify", "MERGE_HEAD"):
        return False
    current_branch = subprocess.run(
        ["git", "rev-parse", "--abbrev-ref", "HEAD"], capture_output=True, text=True
    ).stdout.strip()
    if current_branch not in long_lived_branches:
        return False
    # A merge of commits a long-lived branch already has is a `git pull`, not a PR
    refs = [ref for branch in long_lived_branches for ref in (branch, f"origin/{branch}")]
    return not any(git_succeeds("merge-base", "--is-ancestor", "MERGE_HEAD", ref) for ref in refs)


class MergeRequiresPRNumber(CommitRule):
    """
    UC1: Require a PR number ("#N") in merges into long-lived branches
    """

    name = "merge-requires-pr-number"
    id = "UC1"
    options_spec = [
        ListOption("long-lived-branches", ["master", "main", "dev"], "Branches PRs are merged into")
    ]

    def validate(self, commit: GitCommit) -> Sequence[RuleViolation] | None:
        """
        Check a merge commit's message for a PR number

        :param commit: The commit being linted
        :return: A violation if the PR number is missing and required, else None
        """
        if not merge_needs_pr_number(self.options["long-lived-branches"].value):
            return None
        if not PR_NUMBER.search(commit.message.full):
            return [RuleViolation(self.id, "Merge message must contain a PR number, e.g. '#123'")]
        return None
